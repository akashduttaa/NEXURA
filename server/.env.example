# NEXURA Backend Environment Variables Template

# Server Port configuration
PORT=5000

# MongoDB Connection String (fallback to in-memory/local if omitted)
MONGODB_URI=mongodb://localhost:27017/nexura

# JWT Secret Key for Session Authentication
JWT_SECRET=nexura_super_secret_key_2026

# Nodemailer SMTP Email Service Configuration for Sign Up OTP (Optional)
# If using Gmail, you MUST use a 16-character 'App Password', not your regular login password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
